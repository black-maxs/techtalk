# Salin file ini menjadi .env.local lalu isi nilainya.
# Supabase Dashboard → Project Settings → API Keys (URL ada di Project Settings → Data API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Secret key (sb_secret_...) atau service_role key (legacy). RAHASIA: hanya dipakai di server,
# jangan pernah diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SECRET_KEY=

# Midtrans → Settings → Access Keys → General credential
# Server Key RAHASIA (hanya server). Client Key boleh terlihat publik (NEXT_PUBLIC_).
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=